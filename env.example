# Folio Desk — local secrets (copy to .env.local)

# Required for Clarence — populate / deepen / developmental (flags only; never rewrites prose)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Desktop (Folio Desk.app): you can also put ANTHROPIC_API_KEY in
#   macOS: ~/Library/Application Support/Folio Desk/.env
#   Windows: %APPDATA%/Folio Desk/.env
# Dev desktop still reads this project's .env.local.

# Dropbox sync (OAuth PKCE — App Folder access)
# Create an app at https://www.dropbox.com/developers/apps
#   - Scoped access → App folder
#   - Permissions: files.content.read, files.content.write, account_info.read
#   - Redirect URIs (add each origin you use):
#       http://127.0.0.1:3000/dropbox/callback
#       http://localhost:3000/dropbox/callback
#       https://your-prod-origin/dropbox/callback
# Put the App key (not App secret) below, then restart `npm run dev`.
# NEXT_PUBLIC_DROPBOX_APP_KEY=your_app_key

# Required on Vercel — forces Dropbox OAuth to your stable production URL
# (preview deploys like folio-xxxxx-….vercel.app will otherwise fail OAuth).
# No trailing slash. Redeploy after setting.
NEXT_PUBLIC_APP_ORIGIN=https://folio-jet-eta.vercel.app
