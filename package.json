{
  "name": "folio",
  "productName": "Folio Desk",
  "version": "0.1.0",
  "private": true,
  "description": "Folio Desk — a quiet novel studio for the manuscript and its world.",
  "author": "Folio Desk",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:dev": "concurrently -k -n next,desk -c blue,magenta \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:prepare": "next build && node electron/prepare-standalone.cjs",
    "desktop:start": "npm run desktop:prepare && FOLIO_USE_STANDALONE=1 electron .",
    "desktop:dist": "npm run desktop:prepare && electron-builder --config electron-builder.yml",
    "desktop:dist:mac": "npm run desktop:prepare && electron-builder --config electron-builder.yml --mac",
    "desktop:dist:dir": "npm run desktop:prepare && electron-builder --config electron-builder.yml --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-focus": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-typography": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@turf/turf": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "docx": "^9.7.1",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/file-saver": "^2.0.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  }
}
